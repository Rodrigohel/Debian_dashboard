VITE_API_URL=http://localhost:3002
VITE_WS_URL=ws://localhost:3002/ws

# Caminho onde o app vai ser servido (deixe em branco se for na raiz do
# domínio). Se você serve em http://SEU-IP/ip-dashboard/, defina:
#   VITE_BASE_PATH=/ip-dashboard/
# (com barra no início E no final). Sem isso, os arquivos JS/CSS não são
# encontrados e a página fica em branco.
VITE_BASE_PATH=

# Nome da empresa/condomínio e do painel, e logo, são configurados em tempo
# de execução direto no painel (ícone de engrenagem no cabeçalho, só visível
# para quem está logado). Não é necessário definir aqui.
