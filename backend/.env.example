# Porta HTTP do backend
PORT=3002

# CORS: origem do frontend
CORS_ORIGIN=http://localhost:5174

# --- Rede monitorada ---
# Prefixo /24 usado pelo botão "Escanear rede" (varre .1 a .254 desse prefixo
# procurando IPs que respondem a ping e ainda não estão cadastrados).
NETWORK_BASE=192.168.1

# --- Autenticação ---
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h
SQLITE_PATH=./data/dashboard.db

# Chave usada só para criptografar (AES-256-GCM) a senha de acesso de cada
# equipamento (câmera/NVR/porteiro/etc.) guardada no banco — nunca fica em
# texto puro no SQLite. Troque em produção (o install.sh já gera um valor
# aleatório automaticamente).
CREDENTIALS_KEY=troque-esta-chave-em-producao

# --- Nome padrão (só usado até alguém configurar pela tela de Configurações;
# depois disso o valor salvo no banco manda) ---
DEFAULT_COMPANY_NAME=Minha Empresa
DEFAULT_SITE_NAME=Monitoramento de Rede

# --- Monitoramento (valores iniciais — depois de configurados pela tela de
# Configurações, o valor salvo no banco manda, sem precisar reiniciar) ---
# Intervalo entre rodadas de verificação de TODOS os dispositivos (segundos)
PING_INTERVAL_SECONDS=20
# Tempo máximo de espera por uma resposta de ping/porta, em ms
PING_TIMEOUT_MS=1200
# Quantas falhas de ping SEGUIDAS até marcar o dispositivo como offline
# (evita marcar como "caiu" por causa de 1 pacote perdido isolado)
OFFLINE_THRESHOLD_FAILS=2
# Quantos dispositivos são verificados em paralelo a cada rodada
PING_CONCURRENCY=25
# Por quanto tempo (horas) manter o histórico de latência (para o
# gráfico/sparkline) antes de limpar linhas antigas do banco
CHECKS_RETENTION_HOURS=6
# Intervalo (minutos) para reenviar lembrete de um alerta que continua ativo
# (0 desativa os lembretes, manda só quando fica ativo e quando resolve)
ALERT_REMINDER_INTERVAL_MINUTES=60

# --- Notificação de alertas via Telegram (opcional) ---
# Só valem até serem configurados pela tela de Configurações. Deixe as duas em
# branco para desativar. Para configurar: fale com o @BotFather no Telegram
# (/newbot) para pegar o token; para o chat_id, mande uma mensagem para o bot
# e acesse https://api.telegram.org/bot<TOKEN>/getUpdates
# (o número em "chat":{"id":...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Painel público (sem login) ---
# PUBLIC_DASHBOARD_ENABLED=false desativa completamente (a página só mostra
# a tela de login). Cada card abaixo pode ser ligado/desligado sem mexer em
# código — basta editar aqui e reiniciar o backend (não precisa rebuildar
# o frontend, ele lê a configuração do backend).
PUBLIC_DASHBOARD_ENABLED=true
PUBLIC_SHOW_STATUS=true
PUBLIC_SHOW_HERO_BANNER=true
PUBLIC_SHOW_SUMMARY=true
PUBLIC_SHOW_TYPE_BREAKDOWN=true
# Dados mais sensíveis (IP e nome de cada equipamento, mensagens de alerta
# podem citar detalhes internos) — deixe "false" a menos que realmente
# queira isso público, sem senha, para qualquer visitante.
PUBLIC_SHOW_DEVICES_LIST=false
PUBLIC_SHOW_ALERTS=false
